# Template for `.env` (which is gitignored). Copy it and you're ready for the
# local docker-compose stack:
#
#     cp .env.example .env && just up
#
# The `changeme_*` values are the local dev defaults the compose services read —
# fine for a laptop, NEVER for staging/production. Rotate every secret per
# environment (generate strong values, e.g. `openssl rand -base64 48`).

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=pretty            # pretty | json


# ── Server ──────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# How many seconds before an idle HTTP connection is closed
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s

# Max WebSocket connections per server instance (WS /v1/stream, §11)
WS_MAX_CONNECTIONS_PER_SERVER=1000

# Where `server` (this is the §11 API service binary) reaches the internal
# services it fronts: event-store's and simulation-projection's internal read
# APIs (HTTP) and intelligence's `IntelligenceRead` service (gRPC).
EVENT_STORE_URL=http://127.0.0.1:8081
SIMULATION_URL=http://127.0.0.1:8082
INTELLIGENCE_GRPC_ADDR=http://127.0.0.1:50051

# WS /v1/stream's own Kafka consumer group (uses the shared KAFKA_BROKERS
# below) — distinct from EVENT_STORE_KAFKA_GROUP so the two consumers' offsets
# advance independently. Subscribes to PreliminaryAlertCreated/IncidentCreated/
# IncidentRetracted and fans them out as provisional_alert/alert_confirmed/
# alert_retracted.
SERVER_KAFKA_GROUP=api-service-ws
# Capacity of the broadcast channel WS /v1/stream fans alerts out through —
# how many alerts a slow client can fall behind by before it starts missing
# them (further ones are dropped for that client, not the connection itself).
# Optional; defaults to 1024 when unset.
WS_ALERT_CHANNEL_CAPACITY=1024
# Capacity of the usage-metering queue between the request path and the
# UsageRecorded Kafka publisher (§13) — how many billable events may await
# publish (e.g. during a broker outage) before further ones are dropped with
# a warn rather than stalling customer calls.
# Optional; defaults to 1024 when unset.
USAGE_CHANNEL_CAPACITY=1024
# Client-side deadline (milliseconds) on the screening gRPC read behind
# POST /v1/address/{addr}/screen (§11). The endpoint carries its own
# p50 < 100ms SLO (§19), so a stalled intelligence node fails fast to the
# endpoint's 502 instead of queueing behind the router-wide 30s timeout.
# Optional; defaults to 500 when unset. Must be >= 1.
SCREENING_DEADLINE_MS=500
# Prometheus /metrics bind address (§19) — exposes this service's counters,
# including usage_events_recorded_total / usage_events_dropped_total (§13)
# and http_requests_total / http_request_duration_seconds (the API p50/p99
# panel), which ops alerts on for billing gaps and latency SLOs.
# Optional; defaults to 0.0.0.0:9112 when unset (distinct from
# DETECTION_METRICS_ADDR's 9100 so both run on one host in local dev).
SERVER_METRICS_ADDR=0.0.0.0:9112


# ── PostgreSQL (in-flight jobs, incidents, labels/entities) ─────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mev
POSTGRES_USER=mev
POSTGRES_PASSWORD=changeme_postgres_password

# Full DSN (used by services directly; compose overrides with internal hostname)
DATABASE_URL=postgres://mev:changeme_postgres_password@127.0.0.1:5432/mev?sslmode=disable

# Connection pool
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=30m


# ── Redis (hot cache + risk-score cache, §8.3; also the api-service's
#    dedicated screening rate limiter, §19 — see REDIS_URL below) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0
REDIS_MAXMEMORY=256mb

# Full URL (compose overrides with internal hostname)
REDIS_URL=redis://:changeme_redis_password@127.0.0.1:6379/0


# ── ClickHouse (event store + analytics, §14) ───────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9001          # host port; native protocol is 9000 inside the container
CLICKHOUSE_DB=mev
CLICKHOUSE_USER=mev
CLICKHOUSE_PASSWORD=changeme_clickhouse_password

# Full URL (compose overrides with internal hostname:9000)
CLICKHOUSE_URL=http://mev:changeme_clickhouse_password@127.0.0.1:8123/mev
# Credential-free HTTP base for the `clickhouse` Rust client (user/password/db
# are passed separately, from the vars above). Compose overrides the host.
CLICKHOUSE_HTTP_URL=http://127.0.0.1:8123


# ── Event-store service (§4) ────────────────────────────────────
# Internal HTTP append API bind address.
EVENT_STORE_HOST=0.0.0.0
EVENT_STORE_PORT=8081
# Shared secret internal callers present as `Authorization: Bearer <token>`.
# Distinct from the public JWT below; rotate per environment.
EVENT_STORE_WRITE_TOKEN=changeme_event_store_internal_write_token
# Kafka consumer group — restarts resume from committed offsets.
EVENT_STORE_KAFKA_GROUP=event-store
# Topology the event-store provisions on boot (§20): one topic per event type,
# partitioned by chain. Partitions are the per-chain parallelism/capacity
# ceiling (chain is the message key); replication is 1 for the single local
# broker. Retention bounds the wire (§2/§4 — Kafka is the wire, not the record;
# ClickHouse is the permanent log), so it must be positive (never -1/infinite).
# All optional — these defaults (3 / 1 / 7 days) apply when unset.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
KAFKA_RETENTION_MS=604800000

# Prometheus /metrics bind (§19): event_store_append_duration_seconds,
# event_store_rows_appended_total, event_store_append_errors_total{kind}.
# Optional; defaults to 0.0.0.0:9102 when unset.
#EVENT_STORE_METRICS_ADDR=0.0.0.0:9102


# ── simulation-projection internal read API (§11) ────────────────
# `GET /v1/incidents` bind address — fronted by the public API service below,
# same posture as EVENT_STORE_HOST/PORT.
SIMULATION_PROJECTION_HTTP_HOST=0.0.0.0
SIMULATION_PROJECTION_HTTP_PORT=8082


# ── intelligence gRPC read API (§11) ──────────────────────────────
# `IntelligenceRead` (GetRiskScore/GetLabels/GetBuilderLeaderboard) bind
# address — the `intelligence grpc` run mode.
INTELLIGENCE_GRPC_HOST=0.0.0.0
INTELLIGENCE_GRPC_PORT=50051

# Prometheus /metrics exporter for the intelligence consumers (§19). Optional —
# when set, the `block-production` run mode serves the builder/relay dashboard
# counters (relay hit/miss, snapshots, labels minted, incidents buffered), and
# the `grpc` run mode serves the entity graph/timeline and behavioral-
# similarity read counters.
INTELLIGENCE_METRICS_ADDR=0.0.0.0:9108

# Entity-graph hop query bounds (§8.2/§11, the `intelligence grpc` run mode).
# Optional — operator knobs for the degree-capped walk behind
# `GET /v1/entity/{id}/graph`. A node with more than DEGREE_CAP neighbors is a
# hub the walk stops at (never crosses); MAX_NODES caps the whole response.
# Defaults: 50 and 500. (`hops` is per-request, clamped to 5.)
INTELLIGENCE_GRAPH_DEGREE_CAP=50
INTELLIGENCE_GRAPH_MAX_NODES=500


# ── intelligence block-production pipeline (§10, Sprint 11) ──────
# The `intelligence block-production` run mode: builder/relay attribution per
# canonical block. INTEL_ETH_RPC_URL is the full-block read endpoint (a single
# URL — the ingestion failover pool stays ingestion's); MEV_RELAY_ENDPOINTS is
# the comma-separated MEV-Boost relay data-API list, `name=url` pairs (a bare
# URL names itself by host). Empty relay list = header facts only, no relay
# attribution. Relay identity is configuration, never code (§10).
# INTEL_ETH_RPC_URL=https://eth.example/key1
# MEV_RELAY_ENDPOINTS=flashbots=https://boost-relay.flashbots.net,ultrasound=https://relay.ultrasound.money,agnostic=https://agnostic-relay.net
# MEV_RELAY_TIMEOUT_MS=5000                # per-relay call ceiling
# INTELLIGENCE_PRODUCTION_KAFKA_GROUP=intelligence-block-production


# ── intelligence behavior embeddings (§20.3, Sprint 19) ─────────
# The `intelligence embedding` run mode: the per-address behavior vector
# (activity cadence, counterparty-type distribution, value-flow shape, incident
# history), computed from the ClickHouse adjacency graph on a schedule *and* on
# invalidation. Apply `address_embeddings` + `behavior_baselines` first via
# `intelligence migrate up`.
#
# Every knob below is a *bound*, not a preference — each caps something the
# graph would otherwise make unbounded. Defaults shown.
# INTEL_EMBEDDING_CHAIN_ID=1               # one instance per chain (observations are chain-scoped)
# INTELLIGENCE_EMBEDDING_KAFKA_GROUP=intelligence-embedding
#
# Schema versions to compute (comma-separated). Empty = the newest registered
# version. Naming two is how a v2 rollout stores both side by side; an unknown
# version is a refused boot, never a silent fallback to the default.
# INTEL_EMBEDDING_VERSIONS=behavior-v1
#
# Compute-core bounds.
# INTEL_EMBEDDING_HISTORY_CAP=512          # most-recent observations read per address (§8.2 hub rule)
# INTEL_EMBEDDING_BATCH_SIZE=500           # addresses per batched load — the page the store reads
#                                          # in a FIXED number of queries regardless of size
# INTEL_EMBEDDING_PAGE_CONCURRENCY=4       # pages in flight process-wide, shared by the sweep and
#                                          # the consumer (they run against one connection pool)
# INTEL_EMBEDDING_REFRESH_INTERVAL_SECS=86400
#                                          # how stale an unchanged vector may get before it is
#                                          # rewritten anyway — keeps computed_at readable as
#                                          # "last verified", not just "last changed"
#
# Schedule bounds.
# INTEL_EMBEDDING_SWEEP_INTERVAL_SECS=3600 # how often the sweep ticks
# INTEL_EMBEDDING_SWEEP_LOOKBACK_SECS=10800 # window reach; keep well above the interval so a slow
#                                          # tick cannot leave a gap of unswept active addresses
# INTEL_EMBEDDING_SWEEP_PAGE_SIZE=500      # candidate addresses per adjacency page
# INTEL_EMBEDDING_SWEEP_BUDGET=20000       # max addresses one tick recomputes; on exhaustion the
#                                          # next tick RESUMES FROM ITS CURSOR (never restarts at
#                                          # the lowest address) and
#                                          # intelligence_embedding_sweep_budget_exhausted_total
#                                          # counts it. Watch intelligence_embedding_sweep_lap_seconds
#                                          # for the actual staleness the search inherits.
#
# Horizontal scale: hash-shard the keyspace. Each replica owns the addresses
# that hash into its index, reads only those rows, and keeps its own cursor —
# no coordination, no rebalancing protocol. One pod = the defaults below.
# Deploy as a StatefulSet and map the pod ordinal to SHARD_INDEX.
# An index at or past the total is a refused boot, not a replica that silently
# embeds nothing.
# INTEL_EMBEDDING_SHARD_INDEX=0
# INTEL_EMBEDDING_SHARD_TOTAL=1


# ── intelligence similarity search (§20.3, Sprint 19 t2) ────────
# The `intelligence grpc` run mode's read behind
# `GET /v1/address/{addr}/similar`: addresses that behave like this one, each
# with the behavioral factors that drove the match. Needs migration 0007 (the
# ClickHouse vector index over address_embeddings.vector) and a population
# baseline — run `intelligence embedding-baseline` at least once, or every
# search answers `unavailable_reason: no_baseline`.
#
# The ONE schema version comparisons are served under. Empty = the newest
# registered version. A score only means something inside a single feature
# space, so cutting the read over to a v2 is this deliberate change, never a
# per-request choice; an unknown version is a refused boot.
# INTEL_SIMILARITY_VERSION=behavior-v1
#
# Result bounds. A caller asking past the max is served at the max, not
# rejected.
# INTEL_SIMILARITY_DEFAULT_RESULTS=20
# INTEL_SIMILARITY_MAX_RESULTS=100
#
# The recall knob. The search shortlists candidates off the vector index in
# RAW cosine space, then re-ranks them exactly in baseline-standardized space —
# the index cannot express the standardizing shift, so a neighbour has to
# survive a metric it is not scored by to be seen at all. The multiplier is how
# much slack it gets; MAX_CANDIDATES is what stops one request becoming a
# whole-table read. Raise the multiplier if
# intelligence_similarity_approximate_total is a large share of
# intelligence_similarity_requests_total{outcome="served"}.
# INTEL_SIMILARITY_CANDIDATE_MULTIPLIER=20
# INTEL_SIMILARITY_MAX_CANDIDATES=2000
#
# Bulkhead: concurrent similarity searches allowed in-process. Beyond this,
# requests are SHED (RESOURCE_EXHAUSTED -> 502), never queued — an unbounded
# wait queue is how this endpoint's burst becomes the whole service's latency.
# This read shares a gRPC server and a ClickHouse with GetScreeningFacts, which
# carries a p50 < 100ms SLO (§19); the ceiling is what keeps a burst here from
# degrading that.
# INTEL_SIMILARITY_MAX_CONCURRENT=32
#
# Population-baseline snapshot. The baseline is per-(chain, version), not
# per-address, so it is loaded once and refreshed on a timer rather than read
# on every request. MAX_AGE is a safety floor, not a tuning knob: past it a
# search is REFUSED (no_baseline) rather than ranked against a population that
# has moved on — a confident wrong ranking is worse than no ranking. Watch
# intelligence_similarity_baseline_age_seconds.
# INTEL_SIMILARITY_BASELINE_REFRESH_SECS=300
# INTEL_SIMILARITY_BASELINE_MAX_AGE_SECS=604800
#
# Materialized neighbour rankings (the address_neighbors read model, migration
# 0008): how long a stored ranking may be replayed before recomputing. Set to
# 0 to disable the cache entirely and run every search live.
#
# This bound covers *vector* drift only. Baseline drift is handled exactly, not
# by age: every stored ranking carries the fingerprint of the baseline that
# produced it, and a re-derived baseline invalidates all of them by mismatch —
# which is what preserves §20.3's "a re-derived baseline changes rankings"
# contract in the presence of a cache. Keep at or below the sweep interval so a
# replayed ranking is never staler than the vectors it summarizes. Watch
# intelligence_similarity_neighbor_cache_total{outcome=...}.
# INTEL_SIMILARITY_CACHE_MAX_AGE_SECS=3600


# ── intelligence clustering signal (§20.3/§8.1, Sprint 19 t3) ───
# The `intelligence link-signal` run mode: AddressEmbeddingUpdated in,
# behavioral *candidate links* to directly-known actors out
# (entity_link_candidates + EntityLinkProposed, plus a reduced-confidence
# ScammerAssociate when the anchor is a known bad actor).
#
# It NEVER merges entities. A proposal is a lead for the flywheel (§8.5);
# entity membership still comes only from the §8.2 on-chain evidence
# heuristics. Read the queue with `intelligence link-candidates`, or
# GET /v1/address/{addr}/link-candidates; rule on one with
# `intelligence link-decide <id> confirm|reject <operator> [note]`.
#
# Needs the same prerequisites the search does — migration 0007 and a
# population baseline (`intelligence embedding-baseline`); without a baseline
# every subject is skipped and counted as no_baseline.
#
# Delivery is at-least-once, not at-most-once: the proposal row carries an
# `announced_at` stamp written only after its event is published, so a crash
# between the two re-announces on redelivery (outcome=re_announce) and a boot-
# time sweep drains anything redelivery cannot reach
# (intelligence_link_signal_recovered_total). A duplicate EntityLinkProposed is
# harmless — every downstream write off it is keyed.
#
# Its own consumer group, so it is independently deployable and its lag is
# separately visible.
# INTELLIGENCE_LINK_SIGNAL_KAFKA_GROUP=intelligence-link-signal
#
# THE COST GATE. `unclustered_only` (default) searches only addresses the entity
# graph has not already placed — which is what the signal is for: widening
# recall where evidence cannot reach. `all` makes every clustered address a
# merge-candidate search too, i.e. one ANN scan per address per sweep lap
# against the ClickHouse the p50-critical screening path shares. Change it
# deliberately, after looking at what the default costs.
# INTEL_LINK_SIGNAL_SCOPE=unclustered_only
#
# How many neighbours each search asks for. Small on purpose: proposals are
# capped per subject anyway, so a wider ranking buys only ClickHouse time.
# INTEL_LINK_SIGNAL_NEIGHBORS=10
#
# Proposal thresholds. MIN_SIMILARITY is deliberately high — a missed link is a
# proposal nobody sees, a loose one is an investigator's queue full of bots
# that merely share a strategy. MAX_PER_SUBJECT bounds one address in a dense
# behavioral neighbourhood from writing its whole neighbourhood into the queue.
# Tune against intelligence_link_signal_suppressed_total{reason=...}.
# INTEL_LINK_MIN_SIMILARITY=0.85
# INTEL_LINK_MAX_PER_SUBJECT=3
#
# The §8.1 confidence ladder. The proposal's confidence is this ceiling scaled
# by the similarity that produced it (and discounted again for a truncated,
# hub-window vector), so it is ALWAYS strictly below the entity-derived 0.5
# band: a behavioral guess must never outrank a graph fact. Tunable downward;
# raising it past 0.5 inverts the ladder and is a mistake, not a knob.
# INTEL_LINK_CONFIDENCE_CEILING=0.45
# INTEL_LINK_TRUNCATED_DISCOUNT=0.9


# ── Predictive pipeline service (§16) ───────────────────────────
# A separate binary/deployment from the block-based fast/slow paths (§16):
# mempool prediction (PredictedAlert) + the lending-position tracker/cascade/
# reflexivity engines (§16.1–16.3, LiquidationRiskPredicted/
# LiquidationCascadeWarned) + a live read API with its own Swagger UI (§16.4).
# Runs on CHAIN_ID/KAFKA_BROKERS/INTELLIGENCE_GRPC_ADDR (shared above — one
# instance per chain).
MEMPOOL_RPC_URL=https://eth.example/key1
# Mempool source tuning (optional, defaults shown).
#MEMPOOL_POLL_INTERVAL_MS=500
#MEMPOOL_DEDUP_CAPACITY=50000
# Prometheus /metrics (§19). Optional; defaults to 0.0.0.0:9465.
#METRICS_ADDR=0.0.0.0:9465
# The internal read API (§16.4): GET /v1/positions[/{protocol}/{account}] and
# GET /v1/cascade/simulate?asset=&price= (the reflexivity what-if endpoint),
# Swagger UI at /swagger-ui. Optional; defaults to 0.0.0.0:9466 — always on,
# unlike the K8s HEALTH_ADDR probe (opt-in, unset = off) other services use.
#PREDICTIVE_HTTP_ADDR=0.0.0.0:9466

# Lending position tracker (§16.1). LENDING_RPC_URL defaults to
# MEMPOOL_RPC_URL if unset. Empty LENDING_CONTRACT_ADDRESSES = wired but inert
# (no boot error) — set it to the Aave Pool / Compound CToken market addresses
# to track, comma-separated.
#LENDING_RPC_URL=https://eth.example/key1
#LENDING_CONTRACT_ADDRESSES=0xAavePoolAddress,0xCompoundMarketAddress
#POSITION_CONSUMER_GROUP=predictive-position-tracker
#POSITION_WINDOW_BLOCKS=64                # defaults to the chain's finalization depth
#AAVE_LIQUIDATION_THRESHOLD_BPS=8000      # 80%, a single blended figure per protocol
#COMPOUND_LIQUIDATION_THRESHOLD_BPS=7500  # 75%

# Cascade engine (§16.2). ORACLE_RPC_URL defaults to MEMPOOL_RPC_URL if unset.
# Empty ORACLE_PRICE_FEEDS = wired but inert — set it to comma-separated
# asset:decimals:feed:feed_decimals quads (Chainlink-style aggregators).
#ORACLE_RPC_URL=https://eth.example/key1
#ORACLE_POLL_INTERVAL_MS=2000
#ORACLE_PRICE_FEEDS=0xWETH:18:0xChainlinkEthUsdFeed:8
# Risk-band boundaries (distance_pct thresholds), strictly descending.
#LIQUIDATION_WARNING_DISTANCE_PCT=15.0
#LIQUIDATION_DANGER_DISTANCE_PCT=5.0
#LIQUIDATION_CRITICAL_DISTANCE_PCT=0.0

# Reflexivity model (§16.3): the degree-bounded LiquidationCascadeWarned walk.
# An asset held as collateral by more open positions than the degree cap is a
# hub — the walk stops propagating a shock through it rather than crossing it
# (§8.2's hub-node discipline, mirrored). The price-impact figure is an
# explicit stress-test step, not a real slippage model (see reflexivity.rs).
#CASCADE_DEGREE_CAP=50
#CASCADE_MAX_REFLEXIVE_DEPTH=3
#CASCADE_PRICE_IMPACT_BPS_PER_HOP=500     # 5% assumed price drop per reflexive hop

# §19 metrics (Sprint 16 task 4, on METRICS_ADDR above), no config needed:
# predictive_predictions_total{event_type} — the prediction-rate signal
# (rate() this in PromQL); predictive_liquidation_lead_time_seconds — how
# much runway a LiquidationRiskPredicted forecast gave before the real
# on-chain liquidation, paired by (protocol, account); the complementary
# predictive_liquidations_unpredicted_total counts a liquidation the cascade
# engine never forecast at all.


# ── RabbitMQ (simulation sim.jobs work queue, §7) ───────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Image-native names (read directly by the rabbitmq container)
RABBITMQ_DEFAULT_USER=mev
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/

# Full AMQP URL (compose overrides with internal hostname). The default vhost "/"
# MUST be percent-encoded as %2f — a bare trailing slash means the *empty* vhost
# ("") and the broker rejects it with "vhost not found".
RABBITMQ_URL=amqp://mev:changeme_rabbitmq_password@127.0.0.1:5672/%2f

# Queue topology (§7): durable quorum queue + dead-letter exchange/queue.
RABBITMQ_SIM_QUEUE=sim.jobs
RABBITMQ_SIM_DLX=sim.jobs.dlx
# Quarantine queue bound behind the DLX where jobs land after exhausting retries.
RABBITMQ_SIM_DLQ=sim.jobs.dlq
# Quorum-queue redelivery cap: after this many failed deliveries a job dead-letters
# to the DLX instead of looping forever (§7 "fails N times").
RABBITMQ_SIM_DELIVERY_LIMIT=5

# Prometheus /metrics binds (§19), one per simulation binary — distinct ports
# so the dispatcher/worker/projection can all run on one host. Worker exposes
# simulation_jobs_total{outcome} (the confirmation-rate panel) and
# simulation_job_duration_seconds. All optional (defaults shown).
#SIMULATION_METRICS_ADDR=0.0.0.0:9105
#SIMULATION_WORKER_METRICS_ADDR=0.0.0.0:9106
#SIMULATION_PROJECTION_METRICS_ADDR=0.0.0.0:9111

# How often simulation-projection's scheduler cycles over every opted-in
# monitored wallet to push a §25 exposure report (Sprint 15 t5). Default: 24h.
#EXPOSURE_REPORT_INTERVAL_SECS=86400


# ── Kafka (domain event backbone, §2/§4) ────────────────────────
# App-facing connection string.
#   - From the host (tests, local binaries):   localhost:9092
#   - From inside another compose container:    kafka:29092  (INTERNAL listener)
KAFKA_BROKERS=localhost:9092
KAFKA_INTERNAL_BROKERS=kafka:29092

# Broker config (consumed by the kafka service in docker-compose)
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,INTERNAL://kafka:29092
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,INTERNAL://0.0.0.0:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,INTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=3


# ── Chain source adapter (RPC failover pool, §5 / Sprint 2) ─────
# Comma-separated RPC endpoints in preference order; the pool tries them
# first-to-last, health-checks each, and circuit-breaks a failing one out of
# rotation (adapter #3). REQUIRED for the ingestion service to start.
# ETH_RPC_URLS=https://eth.example/key1,https://eth-backup.example/key2
# ETH_WS_URL — for the node-IPC newHeads adapter (#2), deferred to Phase 8.
# ETH_WS_URL=wss://eth.example/ws/key1
CHAIN_ID=1
FINALIZATION_DEPTH=64            # blocks before a block is treated as final (§15)
FINALIZE_INTERVAL_MS=12000       # how often the pipeline polls the `finalized` tag → BlockFinalized
# Chain events are produced to Kafka via KAFKA_BROKERS (shared, set above).

# RPC pool tuning (all optional — shown with their defaults).
RPC_POLL_INTERVAL_MS=2000        # how often the head poller asks for the tip
RPC_HEALTH_INTERVAL_MS=10000     # how often the active health probe sweeps endpoints
RPC_REQUEST_TIMEOUT_MS=5000      # per-call ceiling; a slower call fails over
# Circuit breaker: open after N consecutive failures, stay open for the cooldown,
# then close after M half-open successes.
RPC_BREAKER_FAILURE_THRESHOLD=5
RPC_BREAKER_OPEN_COOLDOWN_MS=30000
RPC_BREAKER_SUCCESS_THRESHOLD=1

# Prometheus /metrics bind (§19): ingestion_lag_seconds, assembly_duration_seconds,
# reorgs_total/reorg_depth. Optional; defaults to 0.0.0.0:9103 when unset (the
# `run-ingestion-base` just recipe overrides to 9104 so both chain instances
# can run on one host).
#INGESTION_METRICS_ADDR=0.0.0.0:9103


# ── Detection service (§6, §17 / Sprint 4) ─────────────────────
# The fast path: consumes BlockAssembled/BlockReverted off Kafka (KAFKA_BROKERS,
# shared above), fans each block's detectors out on rayon, and produces
# DetectorTriggered/PreliminaryAlertCreated back to Kafka. Runs on CHAIN_ID
# (shared above — one detection instance per chain).
DETECTION_KAFKA_GROUP=detection  # consumer group; restarts resume from committed offsets
# Bounded-channel depths (§17) — the inter-stage backpressure ceilings. The work
# channel holds decoded-but-not-yet-detected blocks; the commit channel holds
# published-but-not-yet-committed ones. Raise to absorb burstier input.
DETECTION_WORK_BUFFER=256
DETECTION_COMMIT_BUFFER=256
# Prometheus /metrics scrape endpoint (§19) — per-detector hit rate + latency.
# Scrape http://<host>:9100/metrics. Bind 0.0.0.0 so a scraper on the deploy
# network reaches it; narrow to 127.0.0.1 for a local-only run.
DETECTION_METRICS_ADDR=0.0.0.0:9100


# ── Rule-engine service (§9 / Sprint 9) ─────────────────────────
# Customer-defined alerting: consumes the intelligence/alert backbone
# (KAFKA_BROKERS shared above), evaluates the stored rules (DATABASE_URL) with
# temporal windows in Redis (REDIS_URL), publishes RuleTriggered/
# RuleAlertCreated, and delivers webhook actions to customer endpoints.
RULE_ENGINE_KAFKA_GROUP=rule-engine
# All optional (defaults shown):
#RULE_REFRESH_SECS=30                 # backstop reload of the enabled rule set
#RULE_FIRES_CAPACITY=1024             # temporal-fires channel bound (§6 backpressure)
#RULE_ENGINE_METRICS_ADDR=0.0.0.0:9107
# Webhook delivery (t5): per-attempt timeout + bounded retries (backoff doubles
# per retry). Redirects are never followed; 4xx is permanent, 5xx/transport
# faults retry up to the attempt budget.
#RULE_WEBHOOK_TIMEOUT_SECS=5
#RULE_WEBHOOK_ATTEMPTS=3
#RULE_WEBHOOK_RETRY_BACKOFF_MS=500


# ── Usage service (§13 / Sprint 12 — metering sink, no billing) ─
# Drains mev.events.UsageRecorded (KAFKA_BROKERS shared above; keyed by
# customer_id so metering load spreads across partitions, §13) into the
# append-only ClickHouse usage_events table (CLICKHOUSE_* shared above; own
# tables + own usage_schema_migrations bookkeeping, §14) plus a daily
# SummingMergeTree rollup (usage_rollup_daily, dashboard surface — exact
# numbers read usage_events with count(DISTINCT event_id), the rollup
# double-counts a redelivered batch), for analytics, capacity planning and
# abuse detection. Consumes only — emits nothing, gates nothing.
USAGE_KAFKA_GROUP=usage
# Micro-batches rows into few, large ClickHouse inserts instead of one insert
# per record (ClickHouse's parts economics: every insert is an on-disk part).
# Flushes at whichever comes first; both optional (defaults shown).
#USAGE_BATCH_MAX_ROWS=5000
#USAGE_BATCH_MAX_WAIT_MS=1000
# A record this sink can never process (a misrouted event type) is parked on
# its own dead-letter topic (mev.dlq.usage) instead of skip-and-forgot —
# inspectable via kafka-console-consumer, replayable once the producer bug is
# fixed. Reuses the backbone's replication/retention knobs (both optional;
# defaults shown — 7 days, matching event-store's KAFKA_RETENTION_MS default).
#KAFKA_TOPIC_REPLICATION=1
#KAFKA_RETENTION_MS=604800000
# Prometheus /metrics bind (§19): usage_rows_ingested_total (landed side of a
# §13 reconciliation against the producers' usage_events_recorded_total),
# usage_rows_skipped_total / dlq_published_total (misrouted events — alert on
# any non-zero rate), batch_flush_total{outcome} (flush health), and
# kafka_consumer_lag (the keeping-up signal to actually page on).
# Optional; defaults to 0.0.0.0:9109 when unset.
#USAGE_METRICS_ADDR=0.0.0.0:9109


# ── Notification service (§11 / Sprint 12 — delivery hardening) ─
# Consumes PreliminaryAlertCreated/IncidentCreated/IncidentRetracted/
# IncidentFinalized/RuleAlertCreated/SanctionHit (KAFKA_BROKERS shared
# above), routes each to severity/kind/chain-filtered subscribers
# (DATABASE_URL shared above — subscribers + the delivery/dedup ledger, own
# tables, §14) over webhook/email/Slack/PagerDuty, and emits UsageRecorded
# (AlertDelivered) on every successful delivery. No customer-facing
# subscriber-management API yet — subscribers are seeded directly against
# `NotificationStore::create_subscriber`.
NOTIFICATION_KAFKA_GROUP=notification
# §16.4 (Sprint 16 task 4): a second, opt-in consumer task for the predictive
# pipeline's own events — PredictedAlert/LiquidationRiskPredicted/
# LiquidationCascadeWarned, each already on its own topic (§2) — routed to
# risk-desk subscribers filtered on AlertKind::Liquidation. Disabled by
# default: a deployment with no risk desk configured never subscribes to
# these topics at all. Its own consumer group (defaults to
# "<NOTIFICATION_KAFKA_GROUP>-predictive") keeps its offsets/lag/DLQ fully
# independent of the incident-stream consumer above — a lagging or down
# predictive pipeline can never stall incident delivery.
#NOTIFICATION_PREDICTIVE_ENABLED=false
#NOTIFICATION_PREDICTIVE_KAFKA_GROUP=notification-predictive
# Shared retry/timeout policy for every HTTP-based channel (webhook/Slack/
# PagerDuty) and SMTP. Redirects are never followed on the HTTP channels; a
# customer-supplied webhook/Slack target resolving to a loopback/private/
# link-local address is refused before any request is attempted (SSRF guard).
# All optional (defaults shown):
#NOTIFICATION_DELIVERY_TIMEOUT_SECS=5
#NOTIFICATION_DELIVERY_ATTEMPTS=3
#NOTIFICATION_DELIVERY_RETRY_BACKOFF_MS=500
# SMTP relay for the email channel (required — no default host).
SMTP_HOST=localhost
#SMTP_PORT=587
SMTP_USERNAME=notification
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM=alerts@mevwatch.example
# Prometheus /metrics bind (§19): notification_notices_total{stage},
# notification_deliveries_total{channel,outcome} — alert on a non-zero
# rejected/failed rate (a revoked/dead endpoint shows up here).
#NOTIFICATION_METRICS_ADDR=0.0.0.0:9110


# ── Observability stack (§19, Sprint 13 t4) ─────────────────────
# Prometheus scrapes every service's /metrics (deploy/prometheus.yml) and
# evaluates SLO alert rules (deploy/prometheus-rules.yml), routed through
# Alertmanager (deploy/alertmanager.yml — a placeholder receiver until a real
# Slack/PagerDuty/email destination is wired ahead of go-live). Tempo receives
# distributed traces over OTLP. Grafana shows the dashboards + trace explore
# (auto-provisioned). Start with `just metrics-up`.
# All optional — the compose defaults below apply when unset.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_QUERY_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Opt-in span export (§19, crates/telemetry): unset (the default) keeps spans
# in-process only — propagation across services still works, nothing is
# queryable. Set to export to the Tempo service above.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318


# ── JWT Auth ────────────────────────────────────────────────────
# Tokens are minted elsewhere against this secret/issuer (no issuance endpoint
# yet); the `sub` claim must be the customer's UUID — the api-service meters
# every authenticated call against it as UsageRecorded (§13).
# Generate with: openssl rand -base64 64
JWT_SECRET=changeme_replace_with_64_char_random_secret_do_not_use_this
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=mev


# ── Rate Limiting (per-tier API limits, requests/min, §11) ──────
# Reserved for a future general `/v1` limiter — not wired to any code yet.
RATE_LIMIT_CLOUD=120
RATE_LIMIT_ONPREM=300
RATE_LIMIT_ENTERPRISE=1000

# `POST /v1/address/{addr}/screen`'s own dedicated ceiling (§19, Sprint 14
# t4) — separate from the general limits above (which nothing enforces yet):
# this one IS wired (crates/server/src/rate_limit.rs), same for every
# customer regardless of §13 pricing tier (metering-only, no tier gating —
# see crates/server/src/rate_limit.rs's module docs).
SCREENING_RATE_LIMIT_PER_MINUTE=120


# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true


# ── LLM seam (§20.4, crates/llm) ────────────────────────────────
# The investigation copilot's model access. Only the copilot service (Sprint
# 20 t2+) reads these — nothing on the detection fast path calls a model.
#
# The key is the one required value; everything else has a working default.
# Secret-bearing, so it is a SecretString in config and never reaches a log.
#ANTHROPIC_API_KEY=sk-ant-...

# Model id is config, never a call-site literal: a draft event is stamped with
# the model that produced it, so a narrative stays attributable after the
# default moves on.
#LLM_MODEL=claude-opus-5
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# Non-streaming output ceiling. Hitting it truncates a draft mid-sentence
# (`stop_reason=max_tokens`), which the copilot must treat as a failure, not
# an answer — so leave room rather than trimming this for cost.
#LLM_MAX_TOKENS=16000

# Per-request HTTP timeout. Deliberately generous: this is a background path
# with nobody waiting, and a thinking model on a long audit stream takes
# minutes.
#LLM_TIMEOUT_SECS=300

# Bounded, *jittered* retry over transient faults (429/5xx/transport). A
# `retry-after` from the API wins over the backoff — up to the cap below.
#LLM_MAX_ATTEMPTS=3
#LLM_RETRY_BACKOFF_MS=2000
#LLM_RETRY_BACKOFF_MAX_MS=30000

# The longest server-directed wait this process will sleep through. Past it the
# call fails as transient and the job queue reschedules it. Holding a worker
# (and, if the caller is a consumer, its partition) for a provider's quota
# window is how a rate limit becomes a rebalance loop that re-does the work.
#LLM_RETRY_AFTER_CAP_SECS=30

# Circuit breaker: consecutive provider faults (transport/5xx — NOT 429s, which
# are a capacity signal) that stop the calls, and how long before a trial call.
#LLM_BREAKER_FAILURE_THRESHOLD=5
#LLM_BREAKER_OPEN_SECS=30

# Bulkhead. This is a PER-POD ceiling and the provider's limit is org-wide, so
# what actually hits the provider is `replicas x this`. Raise it deliberately,
# and prefer a shared (Redis-backed) CallAdmission for a real org budget.
# `0` disables the local limiter entirely.
#LLM_MAX_IN_FLIGHT=4

# Runaway-loop safety valve: refuse calls once this many tokens have been spent
# in the window. Platform-wide protection, NOT a per-customer quota — per-
# customer spend is metered and alarmed, never gated. `0` = off.
#LLM_SPEND_CEILING_TOKENS=0
#LLM_SPEND_WINDOW_SECS=3600

# Response cache, keyed by (model, request digest incl. customer + prompt hash).
# This is what makes at-least-once redelivery affordable: without it a rolling
# update re-bills every in-flight draft and produces a second, differently-worded
# regulatory document. `0` disables it.
#LLM_CACHE_CAPACITY=512
#LLM_CACHE_TTL_SECS=3600

# output_config.effort: low|medium|high|xhigh|max. Unset takes the API
# default (high). Raise for SAR narratives, lower for cheap mechanical calls.
#LLM_EFFORT=

# Ask the API to rescue a safety refusal on another model server-side instead
# of returning it. On by default: an incident narrative is a detailed
# description of an on-chain attack written for a financial-crime report —
# exactly the shape that draws a false-positive decline.
#LLM_FALLBACKS=true


# ── Copilot service (§20.4, crates/copilot) ─────────────────────
# The §7 slow-path shape, deliberately not a plain consumer: a thin
# IncidentCreated consumer records a draft job in Postgres and commits in
# milliseconds, and a worker pool drains the queue out of band. The LLM call
# CANNOT happen inside the consumer handler — `run_consumer` awaits it before
# committing, so a multi-minute completion becomes the poll interval and the
# member is evicted, rebalanced and redelivered into the same billed call.
#
# The `copilot_drafts` row is also the cross-pod llm::CompletionCache, keyed by
# request digest — which is what makes a rolling update cost nothing instead of
# a second, differently-worded regulatory document.
#
# Reads the LLM seam's own knobs from the "LLM seam" section above.
COPILOT_KAFKA_GROUP=copilot
# event-store's root URL. The incident's audit stream is read over its
# internal HTTP read API — never by querying its ClickHouse (§14: no
# cross-service joins).
COPILOT_EVENT_STORE_URL=http://localhost:8085
#COPILOT_EVENT_STORE_TIMEOUT_SECS=30

# Worker pool. §20's "small pool": LLM calls are I/O-bound and the provider's
# limit is org-wide, so this multiplies by the replica count before it reaches
# the provider.
#COPILOT_WORKER_CONCURRENCY=2
# Backstop poll interval. The consumer wakes the pool for its own enqueues;
# this only has to be small enough to pick up another pod's work and expired
# leases promptly.
#COPILOT_POLL_INTERVAL_SECS=5
# How long a claim holds a draft. Boot FAILS unless it covers the worst-case
# job, and note what that includes beyond the obvious: the LLM seam sleeps
# BETWEEN attempts, outside the per-request timeout, so the budget is
#   audit-stream read + (LLM_MAX_ATTEMPTS x LLM_TIMEOUT_SECS)
#                     + ((LLM_MAX_ATTEMPTS - 1) x max(LLM_RETRY_BACKOFF_MAX_MS,
#                                                     LLM_RETRY_AFTER_CAP_SECS))
# — 1020s on the defaults below, not the 900s `attempts x timeout` suggests.
# A lease that expires mid-call lets a second pod reclaim the job and pay for
# the same narrative twice: a doubled bill and two versions of one regulatory
# document, with nothing in any log saying so. The error names every term.
#COPILOT_LEASE_SECS=1200
# Claims per draft before it is retired as `failed` (a refusal or a truncation
# is `blocked` instead — terminal, because re-running it buys a second
# identical decline at full price).
#COPILOT_MAX_ATTEMPTS=3
# Ceiling on one incident's audit stream. A truncated read is carried into the
# prompt, never silently omitted.
#COPILOT_MAX_AUDIT_EVENTS=2000
# Chain stamped on the UsageRecorded facts the metering decorator publishes.
# The copilot is not per-chain — it drafts for whatever incident arrives — so
# this is a deployment label, not a routing key.
#COPILOT_CHAIN=1
# Prometheus /metrics bind (§19): copilot_drafts_enqueued_total{kind,outcome},
# copilot_drafts_finished_total{kind,status}, copilot_jobs_in_flight,
# copilot_job_duration_seconds. The LLM call's own latency/token/stop-reason
# series come from the `llm` seam's MeteredClient, not from here.
#COPILOT_METRICS_ADDR=0.0.0.0:9113
