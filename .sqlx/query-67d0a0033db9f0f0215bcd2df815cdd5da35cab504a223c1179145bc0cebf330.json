  "query": "SELECT body, model, stop_reason, token_usage\n               FROM copilot_drafts\n              WHERE request_digest = $1\n                AND model_digest = $2\n                AND status = ANY($3::TEXT[])\n                AND body IS NOT NULL\n                AND model IS NOT NULL\n                AND stop_reason IS NOT NULL\n              ORDER BY completed_at DESC NULLS LAST\n              LIMIT 1",
