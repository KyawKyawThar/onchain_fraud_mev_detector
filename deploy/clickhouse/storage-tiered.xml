<!--
  Hot/cold storage for the event store (readiness Epic D capacity plan).

  Mount into the ClickHouse server's config.d/ in an environment that tiers,
  then set EVENT_STORE_STORAGE_POLICY=tiered, EVENT_STORE_COLD_VOLUME=cold and
  EVENT_STORE_COLD_AFTER_DAYS on event-store; its boot reconciliation applies
  the policy and the move rule (crates/event-store/src/tiering.rs).

  The hot volume MUST be named `default` and hold the `default` disk. ClickHouse
  lets a table move to a new storage policy only if that policy contains every
  volume of the old one by name, and a table created without a policy is on
  `default`, whose one volume is `default`. A volume called `hot` is refused
  (found by event-store's tiering integration test). `cold` is object storage behind a local cache:
  evidence older than the threshold is read rarely (audits of old incidents),
  and the cache keeps a replay of a recent-but-cold window from paying a
  request per granule.

  Credentials come from the environment, never from this file.
-->
<clickhouse>
  <storage_configuration>
    <disks>
      <cold_s3>
        <type>s3</type>
        <endpoint from_env="CLICKHOUSE_COLD_S3_ENDPOINT"/>
        <access_key_id from_env="CLICKHOUSE_COLD_S3_ACCESS_KEY_ID"/>
        <secret_access_key from_env="CLICKHOUSE_COLD_S3_SECRET_ACCESS_KEY"/>
        <metadata_path>/var/lib/clickhouse/disks/cold_s3/</metadata_path>
      </cold_s3>
      <cold_s3_cache>
        <type>cache</type>
        <disk>cold_s3</disk>
        <path>/var/lib/clickhouse/disks/cold_s3_cache/</path>
        <max_size>10Gi</max_size>
      </cold_s3_cache>
    </disks>
    <policies>
      <tiered>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
          <cold>
            <disk>cold_s3_cache</disk>
          </cold>
        </volumes>
      </tiered>
    </policies>
  </storage_configuration>
</clickhouse>
